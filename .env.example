# 生成方式:
#   SCNET_WG_PRIVATE_KEY=$(wg genkey)
#   SCNET_JWT_SECRET=$(openssl rand -base64 64)
#   DB_PASSWORD=<你设的数据库密码>

SCNET_WG_PRIVATE_KEY=
SCNET_JWT_SECRET=
DB_PASSWORD=

# 可选: Cloudflare relay agent
SCNET_AGENT_URL=
SCNET_AGENT_TOKEN=
SCNET_AGENT_ID=
SCNET_AGENT_BACKEND_URL=http://server:8080
SCNET_AGENT_PING_INTERVAL_MS=15000
SCNET_AGENT_REQUEST_TIMEOUT_MS=20000
SCNET_AGENT_RECONNECT_DELAY_MS=3000

# 后端启动后主动向 Worker 上报 /api/server-info。
# 默认复用 SCNET_AGENT_TOKEN 作为上报鉴权，不需要单独配置 discovery secret。
SCNET_DISCOVERY_ENABLED=false
SCNET_DISCOVERY_URL=https://scnet-test.lonnet.uk/api/server-info
SCNET_DISCOVERY_API_ADDR=https://scnet-test.lonnet.uk/api/v1
SCNET_WG_ENDPOINT=

# 可选: 没有公网固定 UDP 地址时，启用内置 STUN punch/proxy。
# config.yaml 已内置一组中国大陆方向的 STUN 候选；需要替换时再填 SCNET_STUN_SERVERS。
SCNET_PUNCH_ENABLED=false
SCNET_PUNCH_LISTEN_PORT=51280
SCNET_PUNCH_WG_HOST=127.0.0.1
SCNET_PUNCH_WG_PORT=51820
SCNET_STUN_SERVERS=
SCNET_PUNCH_PROBE_TIMEOUT_SECONDS=5
SCNET_PUNCH_KEEPALIVE_SECONDS=20
