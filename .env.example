# 生成方式:
#   SCNET_WG_PRIVATE_KEY=$(wg genkey)
#   SCNET_JWT_SECRET=$(openssl rand -base64 64)
#   DB_PASSWORD=<你设的数据库密码>
#   ADMIN_PASSWORD=<你设的管理员密码>

SCNET_WG_PRIVATE_KEY=
SCNET_JWT_SECRET=
DB_PASSWORD=
ADMIN_PASSWORD=

# 可选: Cloudflare relay agent
SCNET_AGENT_URL=
SCNET_AGENT_TOKEN=
SCNET_AGENT_ID=
SCNET_AGENT_BACKEND_URL=http://server:8080
SCNET_AGENT_PING_INTERVAL_MS=15000
SCNET_AGENT_REQUEST_TIMEOUT_MS=20000
SCNET_AGENT_RECONNECT_DELAY_MS=3000
